# Токен бота MAX (получен от @MasterBot)
MAX_BOT_TOKEN=

# API-gateway нашей клиники
GATEWAY_URL=http://localhost:8080
GATEWAY_TOKEN=medkvadrat_secret_2026

# Путь к SQLite-файлу для связки user_id ↔ patient_id
DB_PATH=./data/bot.db

# Напоминания о приёме (T-3d / T-1d / T-1h через api-gateway)
REMINDER_ENABLED=true
REMINDER_TICK=5m
# Пилот: 1,1587578. Пустой BOT_LINK или REMINDER список — напоминания и «Вы записаны» никому.
REMINDER_ALLOWLIST_PATIENTS=

# Привязка MAX-пользователя к пациенту и доступ к анализам (CSV PATIENTS_ID). Пусто = никому.
BOT_LINK_ALLOWLIST_PATIENTS=

# Сообщение сразу после записи. Включает только владелец.
BOOKING_NOTICE_ENABLED=false

# Smoke inline keyboard: /start и «тест-кнопки» шлют demo-кнопки (выключить в проде)
KEYBOARD_DEBUG=false
